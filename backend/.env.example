# Local-only by default; runtime files are separate from legacy backend/data.
# DRAX_DATA_DIR=/absolute/private/path
DRAX_MAX_FILE_MB=25
DRAX_MAX_PAGES=600
# lexical is lightweight; hybrid requires requirements-semantic.txt
DRAX_RETRIEVAL=lexical
DRAX_EMBEDDING_MODEL=all-MiniLM-L6-v2
DRAX_RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2
# Retain candidates within this raw score window of the best result (heuristic).
DRAX_RERANK_SCORE_WINDOW=3
LMSTUDIO_API=http://127.0.0.1:1234/v1/chat/completions
# Blank discovers the first model returned by the local server.
LMSTUDIO_MODEL=
# Required before network use. All holders share the same library.
DRAX_API_KEY=
DRAX_CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
